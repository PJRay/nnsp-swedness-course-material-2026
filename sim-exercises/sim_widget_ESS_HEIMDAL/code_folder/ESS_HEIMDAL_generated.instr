* Software Centre
* 
* Instrument: ESS_HEIMDAL_generated
* 
* %Identification
* Written by: McCode Py-Generator
* Date: 12:22:56 on September 28, 2026
* Origin: ESS DMSC
* %INSTRUMENT_SITE: Generated_instruments
* 
* !!Please write a short instrument description (1 line) here!!
* 
* %Description
* Please write a longer instrument description here!
* 
* 
* %Parameters
* HighRes: [unit] [1] Select normal=0 or high-resolution mode=1
* T: [unit] [C] temperature
* tau: [unit] [min] reaction time - from 0 to 600 mins
* dmin: [unit] [1] Lower limit of detected d-spacing
* dmax: [unit] [1] High limit of detected d-spacing
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT ESS_HEIMDAL_generated (
double HighRes = 0.0, // [1] Select normal=0 or high-resolution mode=1
double T = 25.0, // [C] temperature
double tau = 0.0, // [min] reaction time - from 0 to 600 mins
double dmin = 0.5, // [1] Lower limit of detected d-spacing
double dmax = 5.5 // [1] High limit of detected d-spacing
)

DECLARE 
%{

  double tof,tofmin,tofmax;
  double det_rad,det_Linst,det_t0,det_th1,det_th2;
  double hm = 2*PI*K2V; // h/m_n
  double samplechoice = 0;
  double Tc = 525;
  double lam0;
  double dlam;
  double dPulse;
  double lmin = 0.65;
  double lmax = 2.35;
  double use_CoFe2O4=1, use_CoFe=1, use_magn=1, f1=0.5, f2=1, f3=1;
  double dfactor = 1;
  int dbins;
  
  char monopts[256];
  char monopts2[256];
  
  struct pieceswisepars {
    double min;
    double max;
    double* uppers;
    double* slopes;
    double* consts;
  };
  double Itime_CoFe2O4; // reaction time dependent intensity factor for CoFe2O4
  double Itime_CoFe; // reaction time dependent intensity factor for CoFe
  struct pieceswisepars pars_CoFe2O4;
  struct pieceswisepars pars_CoFe;
  int piecewiselin(double x, double* val, struct pieceswisepars* fct, int sz);

  //
  // determine Itime_CoFe2O4 and Itime_CoFe
  int piecewiselin(double x, double* val, struct pieceswisepars* fct, int sz) {
    // NOTE: the user is responsible
    double* u = fct->uppers;
    double* s = fct->slopes;
    double* c = fct->consts;
    double min = fct->min;

    // use first found segment
    int i = 0;
    double low, high;
    for (i=0;i<sz;i++) {
      // determine segment lower limit
      if (i==0) low = min;
      else low = u[i-1];

      // determine segment upper limit
      high = u[i];
      if (low<=x && x<=high) {
        fprintf(stdout, "\nl:%1f h:%1f s:%1f c:%1f x:%1f", low, high, s[i], c[i], x);
        *val = s[i]*x + c[i];
        return s[i]*x + c[i];
        //return 0;
      }
    }
    return 1;
  }

    
%}

INITIALIZE 
%{
// Start of initialize for generated ESS_HEIMDAL_generated



// angular range
det_th1 = 10;
det_th2 = 170;
det_rad = 1.5;
det_Linst = 150+det_rad;
tof = det_Linst/hm*lam0*1e6; // tof in [us]
tofmin = det_Linst/hm*lmin*1e6; // tof in [us]
tofmax = det_Linst/hm*lmax*1e6; // tof in [us]
lam0 = (lmax+lmin)/2.0;
dlam = (lmax-lmin)/2.0;

dbins = ceil((dmax-dmin)/0.002);
 
//
// determine temperature-dependent d-spacing stretch
dfactor = 0.02*T/Tc + 1; // latices are scaled by 1% at Tc...



// NOTE:  To enable simple particle weight multiplication, the chosen
//        piecewiselin functions have a max value of 1 or less.

double min = 0;
double u[2] = {50, 600};
double s[2] = {0, 1/250.0};
double c[2] = {0, -50*1/250.0};
pars_CoFe.min = min;
pars_CoFe.uppers = u;
pars_CoFe.slopes = s;
pars_CoFe.consts = c;

piecewiselin(tau, &Itime_CoFe, &pars_CoFe, 2);

double min2 = 0;
double u2[1] = {300};
double s2[1] = {-0.4/300};
double c2[1] = {0.4};
pars_CoFe2O4.min = min2;
pars_CoFe2O4.uppers = u2;
pars_CoFe2O4.slopes = s2;
pars_CoFe2O4.consts = c2;

piecewiselin(tau, &Itime_CoFe2O4, &pars_CoFe2O4, 1);

// DEBUG OUTPUT:
//printf("\nCHECK: CoFe=%1f CoFe2O4=%1f\n", Itime_CoFe, Itime_CoFe2O4);
//exit(1);

 if (HighRes==0) {
   dPulse=3.86e-3*0.05;
 } else {
   dPulse=3.86e-3*0.0017;
 }

 sprintf(monopts,"banana theta limits=[%g %g] bins=600, tof limits=[%g %g] bins=800",det_th1, det_th2, 0.95*tofmin/1e6, tofmax*1.05/1e6);
 sprintf(monopts2,"banana theta limits=[%g %g] bins=600, tof limits=[%g %g] bins=800",-170.0, -55.0, 0.95*tofmin/1e6, tofmax*1.05/1e6);
    
%}

TRACE 
COMPONENT origin = Progress_bar(
 profile = "NULL", percent = 10,
 flag_save = 0, minutes = 0)
AT (0, 0, 0) ABSOLUTE

COMPONENT source = Source_simple(
 radius = 0.1, yheight = 0,
 xwidth = 0, dist = 0,
 focus_xw = 0.01, focus_yh = 0.07,
 E0 = 0, dE = 0,
 lambda0 = lam0, dlambda = dlam,
 flux = 1e14, gauss = 0,
 target_index = 3)
AT (0, 0, 0) RELATIVE origin
ROTATED (0.0, 0.0, 0.0) RELATIVE origin
EXTEND %{

  samplechoice=rand01();
  t=rand01()*dPulse;
  p*=dPulse/3.86e-3;
    
%}

SPLIT 32 COMPONENT SampleArm = Arm()
AT (0, 0, 150) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT sample_2 = PowderN_dspace_factor(
 reflections = "CoFe_56273.txt", geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = 0.005,
 yheight = 0.07, xwidth = 0,
 zdepth = 0, thickness = 0,
 pack = 1, Vc = 0,
 sigma_abs = 0, sigma_inc = 0,
 delta_d_d = 0, p_inc = 0.1,
 p_transmit = 0, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 10, tth_sign = 0,
 p_interact = 0.8, dspace_factor = dfactor,
 concentric = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, focus_flip = 0,
 target_index = 0)
WHEN (( samplechoice >= 0.43 && samplechoice < 0.86 && use_CoFe == 1 ))
AT (0, 0, 150) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source
EXTEND %{

    // peak intensity depends on reaction time
    p *= Itime_CoFe;
    p *= f1;
    
%}

COMPONENT sample_1 = PowderN_dspace_factor(
 reflections = "CoFe2O4_109044.txt", geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = 0.005,
 yheight = 0.07, xwidth = 0,
 zdepth = 0, thickness = 0,
 pack = 1, Vc = 0,
 sigma_abs = 0, sigma_inc = 0,
 delta_d_d = 0, p_inc = 0.1,
 p_transmit = 0, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 10, tth_sign = 0,
 p_interact = 0.8, dspace_factor = dfactor,
 concentric = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, focus_flip = 0,
 target_index = 0)
WHEN (( samplechoice < 0.43 && use_CoFe2O4 == 1 ))
AT (0, 0, 150) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source
EXTEND %{

    // peak intensity varies as a function of reaction time
    p *= Itime_CoFe2O4;
    p *= f2;
    
%}

COMPONENT Magnet = PowderN_dspace_factor(
 reflections = "magnetic_peak.txt", geometry = "NULL",
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, radius = 0.001,
 yheight = 0.07, xwidth = 0,
 zdepth = 0, thickness = 0,
 pack = 1, Vc = 0,
 sigma_abs = 0, sigma_inc = 0,
 delta_d_d = 0, p_inc = 0,
 p_transmit = 0, DW = 0,
 nb_atoms = 1, d_omega = 0,
 d_phi = 10, tth_sign = 0,
 p_interact = 0.8, dspace_factor = dfactor,
 concentric = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, focus_flip = 0,
 target_index = 0)
WHEN (( samplechoice >= 0.86 ))
AT (0, 0, 150) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source
EXTEND %{

    // peak intensity diminishes as a function of temperature
    if (INSTRUMENT_GETPAR(T)<Tc && INSTRUMENT_GETPAR(T)>=0) {
      p *= (Tc-INSTRUMENT_GETPAR(T))/(Tc);
      p *= f3;
      p *= Itime_CoFe2O4;
    }
    else
        ABSORB;
    
%}

COMPONENT psdtof = NPI_tof_theta_monitor(
 filename = "tof_theta.dat", radius = 1.5,
 yheight = 1, tmin = 0.95 * tofmin,
 tmax = tofmax * 1.05, amin = det_th1,
 amax = det_th2, restore_neutron = 1,
 verbose = 0, nt = 800,
 na = 600)
AT (0, 0, 0) RELATIVE sample_1
ROTATED (0.0, 0.0, 0.0) RELATIVE sample_1

COMPONENT npi_tof_dhkl_detector = NPI_tof_dhkl_detector(
 filename = "dhkl.dat", radius = det_rad,
 yheight = 1.0, zdepth = 0.01,
 amin = det_th1, amax = det_th2,
 nd = dbins, na = 800,
 nt = 800, nev = 1,
 d_min = dmin, d_max = dmax,
 time0 = 0, Linst = 152,
 Lc = 0, res_x = 0.002,
 res_y = 0.005, res_t = 1e-6,
 mu = 1.0, mod_shift = 0,
 modulation = 0, mod_dt = 0,
 mod_twidth = dPulse, mod_d0_table = "dhkl.tab",
 verbose = 0, restore_neutron = 1)
AT (0, 0, 0) RELATIVE sample_1
ROTATED (0.0, 0.0, 0.0) RELATIVE sample_1

FINALLY 
%{
// Start of finally for generated ESS_HEIMDAL_generated
%}

END
