* %INSTRUMENT_SITE: Generated_instruments
* 
* !!Please write a short instrument description (1 line) here!!
* 
* %Description
* Please write a longer instrument description here!
* 
* 
* %Parameters
* lambda_min: [unit] [AA] Minimum wavelength from source
* lambda_max: [unit] [AA] Maximum wavelength from source
* slittranslation: [unit] [m] Translation of slit (horizontal)
* sampletranslation: [unit] [m] Sample translation (horizontal)
* slitwidth: [unit] [m] Width of slit pinholes
* slitheight: [unit] [m] Height of slit pinholes
* dist_source2slit: [unit] [m] Distance between source and first slit
* dist_slit2slit: [unit] [m] Distance between slits
* dist_slit2sample: [unit] [m] Distance between second slit and sample
* dist_sample2detector: [unit] [m] Distance between sample and detector
* sampletype: [unit] [1] Sample type: 0 none, 1 mirror, 2+ multilayer
* samplesize: [unit] [m] Side-length of the (quadratic) sample plate
* substratethickness: [unit] [m] Thickness of the substrate
* MR_Qc: [unit] [AA] Critical Q-vector length of mirror sample
* sampleangle: [unit] [deg] Rotation angle of sample (theta)
* detectorangle: [unit] [deg] Rotation angle of detector (2 theta)
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT reflectometer_generated (
double lambda_min = 5.3, // [AA] Minimum wavelength from source
double lambda_max = 5.45, // [AA] Maximum wavelength from source
double slittranslation = 0, // [m] Translation of slit (horizontal)
double sampletranslation = 0, // [m] Sample translation (horizontal)
double slitwidth = 0.001, // [m] Width of slit pinholes
double slitheight = 0.002, // [m] Height of slit pinholes
double dist_source2slit = 1, // [m] Distance between source and first slit
double dist_slit2slit = 3.2, // [m] Distance between slits
double dist_slit2sample = 0.18, // [m] Distance between second slit and sample
double dist_sample2detector = 2, // [m] Distance between sample and detector
double sampletype = 1, // [1] Sample type: 0 none, 1 mirror, 2+ multilayer
double samplesize = 0.15, // [m] Side-length of the (quadratic) sample plate
double substratethickness = 0.003, // [m] Thickness of the substrate
double MR_Qc = 0.15, // [AA] Critical Q-vector length of mirror sample
double sampleangle = 2.5, // [deg] Rotation angle of sample (theta)
double detectorangle = 5 // [deg] Rotation angle of detector (2 theta)
)

DECLARE 
%{

double blocktranslation;
    
%}

INITIALIZE 
%{
// Start of initialize for generated reflectometer_generated

blocktranslation = -slittranslation;
    
%}

TRACE 
COMPONENT Origin = Progress_bar(
 profile = "NULL", percent = 10,
 flag_save = 0, minutes = 0)
AT (0, 0, 0) ABSOLUTE

COMPONENT Source = Source_Maxwell_3(
 size = 0.12, yheight = 0,
 xwidth = 0, Lmin = lambda_min,
 Lmax = lambda_max, dist = dist_source2slit + dist_slit2slit,
 focus_xw = slitwidth, focus_yh = slitheight,
 T1 = 150.42, T2 = 38.72,
 T3 = 14.84, I1 = 3.67E11,
 I2 = 3.64E11, I3 = 0.95E11,
 target_index = 1, lambda0 = 0,
 dlambda = 0)
AT (0, 0, 0) RELATIVE Origin
ROTATED (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT Slit1 = Slit(
 xmin = UNSET, xmax = UNSET,
 ymin = UNSET, ymax = UNSET,
 radius = UNSET, xwidth = slitwidth,
 yheight = slitheight)
AT (0, 0, dist_source2slit) RELATIVE Source
ROTATED (0.0, 0.0, 0.0) RELATIVE Source

COMPONENT Slit2 = Slit(
 xmin = UNSET, xmax = UNSET,
 ymin = UNSET, ymax = UNSET,
 radius = UNSET, xwidth = slitwidth,
 yheight = slitheight)
AT (0, 0, dist_slit2slit) RELATIVE Slit1
ROTATED (0.0, 0.0, 0.0) RELATIVE Slit1

COMPONENT Arm_sampleNOROTNOTRANS = Arm()
AT (blocktranslation, 0, dist_slit2sample) RELATIVE Slit2
ROTATED (0.0, 0.0, 0.0) RELATIVE Slit2

COMPONENT Arm_sampleNOROT = Arm()
AT (sampletranslation, 0, 0) RELATIVE Arm_sampleNOROTNOTRANS
ROTATED (0.0, 0.0, 0.0) RELATIVE Arm_sampleNOROTNOTRANS

COMPONENT Arm_sample = Arm()
AT (0, 0, 0) RELATIVE Arm_sampleNOROT
ROTATED (0, sampleangle, 0) RELATIVE Arm_sampleNOROT

COMPONENT Sample_Mirror = Mirror(
 reflect = 0, xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = MR_Qc, alpha = 6.07,
 m = 1, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 1 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Mirror_backside = Isotropic_Sqw(
 powder_format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, Sqw_coh = 0,
 Sqw_inc = 0, geometry = 0,
 radius = 0, thickness = 0,
 xwidth = samplesize, yheight = samplesize,
 zdepth = substratethickness, threshold = 1e-20,
 order = 0, T = 0,
 verbose = 1, d_phi = 0,
 concentric = 0, rho = 1 / 13.827,
 sigma_abs = 500.08, sigma_coh = 0,
 sigma_inc = 4.935, classical = -1,
 powder_Dd = 0, powder_DW = 0,
 powder_Vc = 0, density = 0,
 weight = 0, p_interact = -1,
 norm = -1, powder_barns = 1,
 quantum_correction = "Frommhold")
WHEN (( sampletype == 1 ))
AT (0, 0, - substratethickness / 2 -1e-6) RELATIVE Sample_Mirror
ROTATED (0.0, 0.0, 0.0) RELATIVE Sample_Mirror

COMPONENT Sample_Multilayer1 = Mirror(
 reflect = "d54DMPC-D2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 2 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Multilayer2 = Mirror(
 reflect = "d54DMPC-H2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 3 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Multilayer3 = Mirror(
 reflect = "hDMPC-D2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 5 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Multilayer4 = Mirror(
 reflect = "hDMPC-H2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 6 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Multilayer5 = Mirror(
 reflect = "silicon-D2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 6 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Sample_Multilayer6 = Mirror(
 reflect = "silicon-H2O.dat", xwidth = samplesize,
 yheight = samplesize, R0 = 0.99,
 Qc = 0.021, alpha = 6.07,
 m = 2, W = 0.003,
 center = 1, transmit = 0)
WHEN (( sampletype == 7 ))
AT (0, 0, 0) RELATIVE Arm_sample
ROTATED (0, 90, 0) RELATIVE Arm_sample

COMPONENT Arm_detectorONLYROT = Arm()
AT (0, 0, 0) RELATIVE Arm_sampleNOROTNOTRANS
ROTATED (0, detectorangle, 0) RELATIVE Source

COMPONENT Arm_detector = Arm()
AT (0, 0, dist_sample2detector) RELATIVE Arm_detectorONLYROT
ROTATED (0.0, 0.0, 0.0) RELATIVE Arm_detectorONLYROT

COMPONENT Detector = PSD_monitor(
 nx = 200, ny = 200,
 filename = "mon_detector", xmin = -0.05,
 xmax = 0.05, ymin = -0.05,
 ymax = 0.05, xwidth = 0.025,
 yheight = 0.05, restore_neutron = 1,
 nowritefile = 0)
AT (0, 0, 0) RELATIVE Arm_detector
ROTATED (0.0, 0.0, 0.0) RELATIVE Arm_detector

FINALLY 
%{
// Start of finally for generated reflectometer_generated
%}

END
