 mask_string = 0, mask_setting = 0,
 number_of_activations = 1, init = "init")
AT (0, positive_foil_center [ 0 ], 0) RELATIVE battery_bottom
ROTATED (0.0, 0.0, 0.0) RELATIVE battery_bottom

COMPONENT positive_foil_layer_0 = Union_box(
