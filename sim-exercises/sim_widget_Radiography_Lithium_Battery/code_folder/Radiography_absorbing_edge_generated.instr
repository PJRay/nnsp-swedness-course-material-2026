 xwidth = battery_width - end_safety, yheight = 2 * negative_electrode_thickness_m + negative_foil_thickness_m,
 zdepth = battery_depth - end_safety, xwidth2 = -1,
 yheight2 = -1, visualize = 1,
 target_index = 0, target_x = 0,
 target_y = 0, target_z = 0,
 focus_aw = 0, focus_ah = 0,
 focus_xw = 0, focus_xh = 0,
 focus_r = 0, plus_z_surface = 0,
