 mask_string = 0, mask_setting = 0,
 number_of_activations = 1, init = "init")
AT (0, 0, 0) RELATIVE samplearm
ROTATED (0.0, 0.0, 0.0) RELATIVE samplearm

COMPONENT battery_bottom = Arm()
AT (0, -0.5 * battery_thickness_m, 0) RELATIVE seperator
ROTATED (0.0, 0.0, 0.0) RELATIVE seperator

COMPONENT positive_electrode_layer_0 = Union_box(
 material_string = "LiFePO4", priority = 50.1 + 0.0,
 xwidth = battery_width - end_safety, yheight = 2 * positive_electrode_thickness_m + positive_foil_thickness_m,
