DEFINE INSTRUMENT Radiography_absorbing_edge_generated (
double D = 0.01, // [m] Diameter of pinhole before sample
double L = 5, // [m] Distance between pinhole and sample
double l = 0.1, // [m] Distance between sample and detector
double sample_used = 0, // [1] Select the battery stack (0) or the absorbing-edge sample (1)
double battery_charge = 1.0 // [1] Battery charge fraction used to interpolate the battery material cross sections
)
DEPENDENCY " -DFUNNEL "

DECLARE 
%{

  double L0  = 5.0;   
double thickness_one_layer_um;
double thickness_one_layer_m;
double thickness_all_layers_um;
double battery_thickness_um;
double battery_thickness_m;

double negative_foil_thickness_m;
double negative_electrode_thickness_m;
double seperator_thickness_m;
double positive_electrode_thickness_m;
double positive_foil_thickness_m;

double LiC6_inc,LiC6_abs;
double LiFePO4_inc,LiFePO4_abs;


// Remember to add generated include declare section
// declare section for battery_stack 
double number_of_layers = 10.000000;
double positive_foil_center[10];
double positive_foil_offset_um;
double positive_foil_offset_m;
double negative_foil_center[10];
double negative_foil_offset_um;
double negative_foil_offset_m;
int counter;


double battery_width;
double battery_depth;
double negative_foil_thickness_um;
double negative_electrode_thickness_um;
double seperator_thickness_um;
double positive_electrode_thickness_um;
double positive_foil_thickness_um;
double end_safety;

double sample_xoff ; /* Sample x offset */
double det_w = 0.10;
double det_h = 0.10;  
double sample_x=0.10;
double sample_y=0.10;
double sigma_inc=1e-4;/*Smallest possible value close to 0 where the absorption XS is still correctly calculated in the Incoherent component*/
double sqrt2=1.414214;         
double frac_interact=1e-6; // set to something close to zero since we don't want to look at inchorent scattering. But do not set to 0 since then the scattering from sigma_inc will be considered            

double sigma_abs=5.08;
double Vc=13.827;
double sample_z=0.01;

double Rota=90;
    
%}

INITIALIZE 
%{
// Start of initialize for generated Radiography_absorbing_edge_generated



sample_xoff  = sample_x/2*sqrt(2); /* Sample x offset */

if (sample_used == 1){Rota = 0;}

battery_width=0.02;
battery_depth=0.01;
negative_foil_thickness_um=100;
negative_electrode_thickness_um=150;
seperator_thickness_um=80;
positive_electrode_thickness_um=190;
positive_foil_thickness_um=95;
end_safety=0.0001;

negative_foil_thickness_m=negative_foil_thickness_um * 1E-6;
negative_electrode_thickness_m=negative_electrode_thickness_um * 1E-6;
seperator_thickness_m=seperator_thickness_um * 1E-6;
positive_electrode_thickness_m=positive_electrode_thickness_um * 1E-6;
positive_foil_thickness_m=positive_foil_thickness_um * 1E-6;

// Calculate layer thickness
thickness_one_layer_um=2*negative_electrode_thickness_um+negative_foil_thickness_um+2*seperator_thickness_um+2*positive_electrode_thickness_um+positive_foil_thickness_um;
thickness_one_layer_m = thickness_one_layer_um * 1E-6;

thickness_all_layers_um=number_of_layers*thickness_one_layer_um;

// Add extra layer of seperator on top
battery_thickness_um = thickness_all_layers_um + seperator_thickness_um;
battery_thickness_m = battery_thickness_um * 1E-6;



// Li content in LiC6 part depends on charge level, and thus do the cross sections for incoherent / absorption

//LiC6 attenuation factors (inc,abs) (1.5562,118.5159)
//C6 attenuation factors (inc,abs) (0.0113,0.0397)

LiC6_inc = 0.0113 + battery_charge*(1.5562-0.0113);
LiC6_abs = 0.0397 + battery_charge*(118.5159-0.0397);

//LiFePO4 attenuation factors (inc,abs) (1.8253,100.6390)
//FePO4 attenuation factors (inc,abs) (0.0221,0.43554)

LiFePO4_inc = 1.8253 - battery_charge*(1.8253-0.0221);
LiFePO4_abs = 100.6390 - battery_charge*(100.6390-0.43554);


// Remember to add generated include initialize section
// Start of initialize for generated battery_stack
positive_foil_offset_um = seperator_thickness_um + positive_electrode_thickness_um + 0.5*positive_foil_thickness_um;
negative_foil_offset_um = 2.0*seperator_thickness_um + 2.0*positive_electrode_thickness_um + positive_foil_thickness_um + negative_electrode_thickness_um + 0.5*negative_foil_thickness_um;
positive_foil_offset_m = positive_foil_offset_um * 1E-6;
negative_foil_offset_m = negative_foil_offset_um * 1E-6;
for (counter=0;counter<number_of_layers;counter++) {
  positive_foil_center[counter] = positive_foil_offset_m + (double)counter*thickness_one_layer_m;
  negative_foil_center[counter] = negative_foil_offset_m + (double)counter*thickness_one_layer_m;
}







    
%}

TRACE 
COMPONENT init = Union_init()
AT (0, 0, 0) ABSOLUTE

COMPONENT Copper_Incoherent = Incoherent_process(
 sigma = 4.6701, f_QE = 0,
 gamma = 0, packing_factor = 1,
 unit_cell_volume = 100, interact_fraction = -1,
 init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Copper_Powder = Powder_process(
 reflections = "Cu.laz", packing_factor = 1,
 Vc = 0, delta_d_d = 0,
 DW = 0, nb_atoms = 1,
 d_phi = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, interact_fraction = -1,
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Copper = Union_make_material(
 process_string = "Copper_Incoherent,Copper_Powder", my_absorption = 32.0961,
 absorber = 0, refraction_density = 0,
 refraction_sigma_coh = 0, refraction_weight = 0,
 refraction_SLD = -1500, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiC6_incoherent = Incoherent_process(
 sigma = LiC6_inc, f_QE = 0,
 gamma = 0, packing_factor = 1,
 unit_cell_volume = 100, interact_fraction = -1,
 init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiC6_fake_powder = Powder_process(
 reflections = "C_battery.laz", packing_factor = 1,
 Vc = 0, delta_d_d = 0,
 DW = 0, nb_atoms = 1,
 d_phi = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, interact_fraction = -1,
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiC6 = Union_make_material(
 process_string = "LiC6_incoherent,LiC6_fake_powder", my_absorption = LiC6_abs,
 absorber = 0, refraction_density = 0,
 refraction_sigma_coh = 0, refraction_weight = 0,
 refraction_SLD = -1500, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT POE_incoherent = Incoherent_process(
 sigma = 476.7338, f_QE = 0,
 gamma = 0, packing_factor = 1,
 unit_cell_volume = 100, interact_fraction = -1,
 init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Electrolyte = Union_make_material(
 process_string = "POE_incoherent", my_absorption = 1.9862,
 absorber = 0, refraction_density = 0,
 refraction_sigma_coh = 0, refraction_weight = 0,
 refraction_SLD = -1500, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiFePO4_incoherent = Incoherent_process(
 sigma = LiFePO4_inc, f_QE = 0,
 gamma = 0, packing_factor = 1,
 unit_cell_volume = 100, interact_fraction = -1,
 init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiFePO4_powder = Powder_process(
 reflections = "LiFePO4.lau", packing_factor = 1,
 Vc = 0, delta_d_d = 0,
 DW = 0, nb_atoms = 1,
 d_phi = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, interact_fraction = -1,
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT LiFePO4 = Union_make_material(
 process_string = "LiFePO4_incoherent,LiFePO4_powder", my_absorption = LiFePO4_abs,
 absorber = 0, refraction_density = 0,
 refraction_sigma_coh = 0, refraction_weight = 0,
 refraction_SLD = -1500, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Aluminum_incoherent = Incoherent_process(
 sigma = 0.0494, f_QE = 0,
 gamma = 0, packing_factor = 1,
 unit_cell_volume = 100, interact_fraction = -1,
 init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Aluminum_Powder = Powder_process(
 reflections = "Al.laz", packing_factor = 1,
 Vc = 0, delta_d_d = 0,
 DW = 0, nb_atoms = 1,
 d_phi = 0, density = 0,
 weight = 0, barns = 1,
 Strain = 0, interact_fraction = -1,
 format = { 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 , 0 }, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Aluminum = Union_make_material(
 process_string = "Aluminum_incoherent,Aluminum_Powder", my_absorption = 1.3920,
 absorber = 0, refraction_density = 0,
 refraction_sigma_coh = 0, refraction_weight = 0,
 refraction_SLD = -1500, init = "init")
AT (0, 0, 0) ABSOLUTE

COMPONENT Origin = Progress_bar(
 profile = "NULL", percent = 10,
 flag_save = 0, minutes = 0)
AT (0, 0, 0) ABSOLUTE

COMPONENT source = Source_gen(
 flux_file = "NULL", xdiv_file = "NULL",
 ydiv_file = "NULL", radius = 0.0,
 dist = L0, focus_xw = D,
 focus_yh = D, focus_aw = 0,
 focus_ah = 0, E0 = 0,
 dE = 0, lambda0 = 1.798,
 dlambda = 1, I1 = 1,
 yheight = 0.1, xwidth = 0.1,
 verbose = 0, T1 = 0,
 flux_file_perAA = 0, flux_file_log = 0,
 Lmin = 0, Lmax = 0,
 Emin = 0, Emax = 0,
 T2 = 0, I2 = 0,
 T3 = 0, I3 = 0,
 zdepth = 0, target_index = 1)
AT (0, 0, 0) RELATIVE Origin
ROTATED (0.0, 0.0, 0.0) RELATIVE Origin

COMPONENT pinhole = Slit(
 xmin = UNSET, xmax = UNSET,
 ymin = UNSET, ymax = UNSET,
 radius = D / 2, xwidth = UNSET,
 yheight = UNSET)
AT (0, 0, L0) RELATIVE source
ROTATED (0.0, 0.0, 0.0) RELATIVE source

COMPONENT incoherent = Incoherent(
 geometry = 0, radius = 0,
 xwidth = 1, yheight = 1,
 zdepth = 0.001, thickness = 0,
 target_x = 0, target_y = 0,
 target_z = L + l + battery_depth, focus_r = 0,
 focus_xw = 0.006, focus_yh = battery_width * 1.1,
 focus_aw = 0, focus_ah = 0,
 target_index = 0, pack = 1,
 p_interact = 1, f_QE = 0,
 gamma = 0, Etrans = 0,
 deltaE = 0, sigma_abs = 0.0001,
 sigma_inc = 0.0001, Vc = 1,
 concentric = 0, order = 0)
AT (0, 0, 0.001) RELATIVE pinhole
ROTATED (0.0, 0.0, 0.0) RELATIVE pinhole

COMPONENT samplearm = Arm()
AT (0, 0, L) RELATIVE pinhole
ROTATED (0, 0, Rota) RELATIVE pinhole

COMPONENT seperator = Union_box(
 material_string = "Electrolyte", priority = 50,
 xwidth = battery_width, yheight = battery_thickness_m,
 zdepth = battery_depth, xwidth2 = -1,
 yheight2 = -1, visualize = 1,
 target_index = 0, target_x = 0,
 target_y = 0, target_z = 0,
