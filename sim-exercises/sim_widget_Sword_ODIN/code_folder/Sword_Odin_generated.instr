COMPONENT Sword = Union_master(
 enable_refraction = 1, enable_reflection = 1,
 verbal = 0, list_verbal = 0,
 finally_verbal = 0, allow_inside_start = 0,
 enable_tagging = 0, history_limit = 300000,
 enable_conditionals = 1, inherit_number_of_scattering_events = 0,
 weight_ratio_limit = 1e-90, init = "init")
WHEN (( Sample == 1 ))
AT (0, 0, 0) RELATIVE a1
ROTATED (0, 0, 0) RELATIVE a1

COMPONENT Stop = Union_stop()
AT (0, 0, 0) RELATIVE a1
ROTATED (0.0, 0.0, 0.0) RELATIVE a1

COMPONENT screen = PSD_monitor_Filter(
 nx = 300, ny = 300,
 nL = 200, filter_pixels = 600,
 filename = "absoprtion_picture.dat", xmin = -0.05,
 xmax = 0.05, ymin = -0.05,
 ymax = 0.05, xwidth = 0.3,
 yheight = 0.3, restore_neutron = 0,
 nowritefile = 0, TwoD_filename = spacial_resolution,
 L_filename = wavelength_spectrum, Lmin = 0,
 Lmax = 10, aply_xy_filter = 1,
 filter_xmin = -0.8, filter_xmax = 0.8,
 filter_ymin = -0.8, filter_ymax = 0.8,
 pinhol_filter_distance = 25.025, pinhol_detector_distance = pinhole_detector_distance,
 smoothing = 3.0, zoom = Zoom)
AT (0, 0, pinhole_detector_distance) RELATIVE graph
ROTATED (0.0, 0.0, 0.0) RELATIVE graph

COMPONENT L_monitor = L_monitor(
 nL = 200, filename = "I_lambda.dat",
 nowritefile = 0, xmin = -0.05,
 xmax = 0.05, ymin = -0.05,
 ymax = 0.05, xwidth = 1,
